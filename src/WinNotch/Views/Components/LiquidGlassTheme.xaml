<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Liquid Glass Theme — iOS 26 Inspired ═══ -->
    <!-- Dark text on frosted glass, like real iOS Liquid Glass on light surfaces. -->
    <!-- The glass tint (~22% white) creates enough frosting for dark text readability. -->

    <!-- Notch — glass tint: slightly stronger for text readability -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="NotchShadowBrush" Color="#20000000"/>

    <!-- Text hierarchy — dark text on frosted glass (like iOS 26) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6181818"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CC2A2A2A"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#AA3A3A3A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#88505050"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#77606060"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#66707070"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#55808080"/>
    <SolidColorBrush x:Key="TextFaintestBrush" Color="#44909090"/>
    <SolidColorBrush x:Key="SettingLabelBrush" Color="#CC2E2E2E"/>
    <SolidColorBrush x:Key="BatteryTextBrush" Color="#99404040"/>

    <!-- Surfaces — layered translucent glass with depth -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#CC303030"/>
    <SolidColorBrush x:Key="SegmentedBgBrush" Color="#10000000"/>
    <SolidColorBrush x:Key="SegmentedCheckedBgBrush" Color="#30FFFFFF"/>

    <!-- Toggle switch — dark track, white thumb -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#28000000"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFFFF"/>

    <!-- Segmented radio — dark text on glass -->
    <SolidColorBrush x:Key="SegmentedTextBrush" Color="#88606060"/>
    <SolidColorBrush x:Key="SegmentedHoverBgBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="SegmentedHoverTextBrush" Color="#CC3A3A3A"/>
    <SolidColorBrush x:Key="SegmentedCheckedTextBrush" Color="#E6181818"/>

    <!-- Overlays / hover — interaction states -->
    <SolidColorBrush x:Key="TransportHoverBrush" Color="#12000000"/>
    <SolidColorBrush x:Key="TransportPressedBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0C000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#18000000"/>

    <!-- Scrollbar — translucent dark -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#28000000"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#38000000"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#48000000"/>

    <!-- Battery — readable on glass -->
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#88505050"/>
    <SolidColorBrush x:Key="BatteryNormalFillBrush" Color="#CC303030"/>

    <!-- HUD — dark for visibility through glass -->
    <SolidColorBrush x:Key="HudIconBrush" Color="#E6202020"/>
    <SolidColorBrush x:Key="HudSliderFillBrush" Color="#DD303030"/>

    <!-- Audio visualizer -->
    <Color x:Key="VisualizerBarColor">#CC303030</Color>

</ResourceDictionary>
