<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Liquid Glass Theme (iOS-inspired) ═══ -->
    <!-- Ultra-transparent frosted glass effect with vibrant clarity, mimicking iOS liquid glass material -->

    <!-- Notch - Extremely transparent with subtle white tint for glass effect -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="NotchShadowBrush" Color="#25000000"/>

    <!-- Text hierarchy - Crisp white with excellent contrast like iOS -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#EBEBEB"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#D8D8D8"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#CACACA"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#BABABA"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextFaintestBrush" Color="#999999"/>
    <SolidColorBrush x:Key="SettingLabelBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="BatteryTextBrush" Color="#E0E0E0"/>

    <!-- Surfaces - Ultra-translucent layered glass -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedBgBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedCheckedBgBrush" Color="#35FFFFFF"/>

    <!-- Toggle switch - Clean iOS-style with glass material -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#30FFFFFF"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF"/>

    <!-- Segmented radio - Glass layers with high clarity -->
    <SolidColorBrush x:Key="SegmentedTextBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="SegmentedHoverBgBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedHoverTextBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SegmentedCheckedTextBrush" Color="#FFFFFF"/>

    <!-- Overlays / hover - Subtle glass-like interaction states -->
    <SolidColorBrush x:Key="TransportHoverBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="TransportPressedBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#30FFFFFF"/>

    <!-- Scrollbar - Translucent and minimal -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#50FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#68FFFFFF"/>

    <!-- Battery - Bright and clear with glass clarity -->
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BatteryNormalFillBrush" Color="#FFFFFF"/>

    <!-- HUD - Vibrant white for maximum visibility through glass -->
    <SolidColorBrush x:Key="HudIconBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HudSliderFillBrush" Color="#FFFFFF"/>

    <!-- Audio visualizer - Pure white for liquid glass aesthetic -->
    <Color x:Key="VisualizerBarColor">#FFFFFF</Color>

</ResourceDictionary>
