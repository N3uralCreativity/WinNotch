<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Light Theme ═══ -->

    <!-- Notch -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="NotchShadowBrush" Color="#999999"/>

    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#444444"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#999999"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#BBBBBB"/>
    <SolidColorBrush x:Key="TextFaintestBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="SettingLabelBrush" Color="#555555"/>
    <SolidColorBrush x:Key="BatteryTextBrush" Color="#666666"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#333333"/>
    <SolidColorBrush x:Key="SegmentedBgBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="SegmentedCheckedBgBrush" Color="#FFFFFF"/>

    <!-- Toggle switch -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="White"/>

    <!-- Segmented radio text -->
    <SolidColorBrush x:Key="SegmentedTextBrush" Color="#888888"/>
    <SolidColorBrush x:Key="SegmentedHoverBgBrush" Color="#15000000"/>
    <SolidColorBrush x:Key="SegmentedHoverTextBrush" Color="#555555"/>
    <SolidColorBrush x:Key="SegmentedCheckedTextBrush" Color="#1A1A1A"/>

    <!-- Overlays / hover -->
    <SolidColorBrush x:Key="TransportHoverBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="TransportPressedBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#15000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#25000000"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#44000000"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#88000000"/>

    <!-- Battery -->
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#888888"/>
    <SolidColorBrush x:Key="BatteryNormalFillBrush" Color="#333333"/>

    <!-- HUD -->
    <SolidColorBrush x:Key="HudIconBrush" Color="#333333"/>
    <SolidColorBrush x:Key="HudSliderFillBrush" Color="#333333"/>

    <!-- Audio visualizer -->
    <Color x:Key="VisualizerBarColor">#333333</Color>

</ResourceDictionary>
