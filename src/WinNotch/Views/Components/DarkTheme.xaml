<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Dark Theme ═══ -->

    <!-- Notch -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="Black"/>
    <SolidColorBrush x:Key="NotchShadowBrush" Color="Black"/>

    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#888888"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#777777"/>
    <SolidColorBrush x:Key="TextSubtleBrush" Color="#666666"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TextFaintestBrush" Color="#444444"/>
    <SolidColorBrush x:Key="SettingLabelBrush" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="BatteryTextBrush" Color="#999999"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedBgBrush" Color="#1A1A1C"/>
    <SolidColorBrush x:Key="SegmentedCheckedBgBrush" Color="#2A2A2E"/>

    <!-- Toggle switch -->
    <SolidColorBrush x:Key="ToggleTrackOffBrush" Color="#3A3A3C"/>
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="White"/>

    <!-- Segmented radio text -->
    <SolidColorBrush x:Key="SegmentedTextBrush" Color="#777777"/>
    <SolidColorBrush x:Key="SegmentedHoverBgBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedHoverTextBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="SegmentedCheckedTextBrush" Color="#FFFFFF"/>

    <!-- Overlays / hover -->
    <SolidColorBrush x:Key="TransportHoverBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="TransportPressedBrush" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#30FFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#44FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#88FFFFFF"/>

    <!-- Battery -->
    <SolidColorBrush x:Key="BatteryBorderBrush" Color="#888888"/>
    <SolidColorBrush x:Key="BatteryNormalFillBrush" Color="#FFFFFF"/>

    <!-- HUD -->
    <SolidColorBrush x:Key="HudIconBrush" Color="White"/>
    <SolidColorBrush x:Key="HudSliderFillBrush" Color="White"/>

    <!-- Audio visualizer -->
    <Color x:Key="VisualizerBarColor">White</Color>

</ResourceDictionary>
