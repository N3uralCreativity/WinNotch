<Window x:Class="WinNotch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Settings"
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource NotchFillBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/ToggleSwitchStyle.xaml"/>
                <ResourceDictionary Source="Components/RoundedScrollBarStyle.xaml"/>
                <ResourceDictionary Source="Components/SegmentedRadioStyle.xaml"/>
                <ResourceDictionary Source="Components/IconButtonStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,18,0,10"/>
            </Style>
            <Style x:Key="SettingRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="Height" Value="32"/>
            </Style>
            <Style x:Key="SettingLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SettingLabelBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource NotchFillBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
        <Grid Margin="24,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar with close button -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right"
                        Click="OnCloseClick"
                        Style="{StaticResource IconButton}"
                        Foreground="{DynamicResource TextMutedBrush}" FontSize="14"
                        Width="28" Height="28"/>
            </Grid>

            <!-- Scrollable settings -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="0,4,0,0"
                          Style="{StaticResource RoundedScrollViewer}">
                <StackPanel>

                    <!-- GENERAL -->
                    <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Start on boot" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="StartOnBootCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- Hover mode -->
                    <TextBlock Text="Hover behavior" Foreground="{DynamicResource SettingLabelBrush}" FontSize="12" Margin="0,8,0,4"/>
                    <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="HoverPeekRadio" Content="Peek + Click"
                                         Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                         Checked="OnHoverModeChanged"/>
                            <RadioButton x:Name="LongHoverRadio" Content="Long hover opens"
                                         Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                         Checked="OnHoverModeChanged"/>
                        </Grid>
                    </Border>

                    <!-- APPEARANCE -->
                    <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Theme" Foreground="{DynamicResource SettingLabelBrush}" FontSize="12" Margin="0,8,0,4"/>
                    <Border Background="{DynamicResource SegmentedBgBrush}" CornerRadius="10" Padding="2" Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="ThemeDarkRadio" Content="Dark"
                                         Grid.Column="0" Style="{StaticResource SegmentedRadio}"
                                         Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeLightRadio" Content="Light"
                                         Grid.Column="1" Style="{StaticResource SegmentedRadio}"
                                         Checked="OnThemeChanged"/>
                        </Grid>
                    </Border>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Adapt to Windows theme" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="AdaptToWindowsThemeCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnAdaptThemeChanged" Unchecked="OnAdaptThemeChanged"/>
                    </Grid>
                    <TextBlock Text="Uses Windows light or dark mode, accent color, and contrast-safe accessibility colors live."
                               Foreground="{DynamicResource TextSubtleBrush}" FontSize="11" Margin="0,0,0,4"
                               TextWrapping="Wrap"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show shadow" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowShadowCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- MUSIC -->
                    <TextBlock Text="Music" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show music controls" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show audio visualizer" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowVisualizerCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- HUD -->
                    <TextBlock Text="System HUD" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Volume HUD" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="VolumeHudCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Brightness HUD" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="BrightnessHudCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- BATTERY -->
                    <TextBlock Text="Battery" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show battery indicator" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowBatteryCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- CALENDAR -->
                    <TextBlock Text="Calendar" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show calendar panel" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="ShowCalendarCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    </Grid>

                    <!-- BETA FEATURES -->
                    <TextBlock Text="Beta Features" Style="{StaticResource SectionHeader}"/>

                    <Grid Style="{StaticResource SettingRow}">
                        <TextBlock Text="Liquid Glass Theme" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="LiquidGlassCheck" Style="{StaticResource ToggleSwitch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="OnLiquidGlassChanged" Unchecked="OnLiquidGlassChanged"/>
                    </Grid>

                    <!-- ABOUT -->
                    <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>

                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextSubtleBrush}" FontSize="12"
                               Text="WinNotch v0.6.1"
                               Margin="0,0,0,2"/>
                    <TextBlock Foreground="{DynamicResource TextFaintestBrush}" FontSize="11"
                               Text="Inspired by boring.notch for macOS"
                               Margin="0,0,0,6"/>

                    <!-- Update check -->
                    <Grid Margin="0,0,0,8">
                        <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick"
                                HorizontalAlignment="Left" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="0">
                            <TextBlock x:Name="CheckUpdateText" Text="Check for updates"
                                       Foreground="{DynamicResource TextSubtleBrush}" FontSize="11"
                                       TextDecorations="Underline"/>
                        </Button>
                        <Button x:Name="UpdateButton" Click="OnUpdateClick"
                                Visibility="Collapsed" HorizontalAlignment="Left"
                                Cursor="Hand" Padding="8,4" Background="{DynamicResource SegmentedCheckedBgBrush}"
                                BorderThickness="0">
                            <TextBlock x:Name="UpdateButtonText" Text="Update available"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
