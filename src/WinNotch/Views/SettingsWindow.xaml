<Window x:Class="WinNotch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Settings"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingToggle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   Foreground="White"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,4"/>

        <!-- Scrollable settings -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="0,4,0,4">
            <StackPanel>

                <!-- GENERAL -->
                <TextBlock Text="General" Style="{StaticResource SectionHeader}"/>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Start on boot" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="StartOnBootCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Open on hover" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="OpenOnHoverCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- APPEARANCE -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show shadow" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowShadowCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- MUSIC -->
                <TextBlock Text="Music" Style="{StaticResource SectionHeader}"/>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show music controls" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowMusicCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show audio visualizer" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowVisualizerCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- HUD -->
                <TextBlock Text="System HUD" Style="{StaticResource SectionHeader}"/>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Volume HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="VolumeHudCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Brightness HUD" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="BrightnessHudCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- BATTERY -->
                <TextBlock Text="Battery" Style="{StaticResource SectionHeader}"/>

                <Grid Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show battery indicator" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="ShowBatteryCheck" Style="{StaticResource SettingToggle}"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                </Grid>

                <!-- ABOUT -->
                <TextBlock Text="About" Style="{StaticResource SectionHeader}"/>

                <TextBlock Foreground="#888888" FontSize="12"
                           Text="WinNotch v0.1 — A Dynamic Island for Windows"
                           Margin="0,0,0,4"/>
                <TextBlock Foreground="#666666" FontSize="11"
                           Text="Inspired by boring.notch for macOS"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock Foreground="#555555" FontSize="11"
                       VerticalAlignment="Center"
                       Text="Changes are saved automatically"
                       Margin="0,0,12,0"/>
        </StackPanel>
    </Grid>
</Window>
