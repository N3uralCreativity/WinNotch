<UserControl x:Class="WinNotch.Views.BatteryIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tiny battery indicator for closed notch right side -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                Margin="0,0,2,0">

        <!-- Battery icon (drawn with borders) -->
        <Grid Width="18" Height="10" VerticalAlignment="Center">
            <!-- Battery body -->
            <Border BorderBrush="#888888" BorderThickness="1" CornerRadius="1.5"
                    Margin="0,0,2,0">
                <Border x:Name="BatteryFill"
                        Background="#4CAF50"
                        CornerRadius="0.5"
                        Margin="1"
                        HorizontalAlignment="Left"/>
            </Border>
            <!-- Battery tip -->
            <Border Width="2" Height="5"
                    Background="#888888" CornerRadius="0,1,1,0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Percent text -->
        <TextBlock x:Name="PercentText"
                   Text="100%"
                   FontSize="9"
                   Foreground="#999999"
                   VerticalAlignment="Center"
                   Margin="3,0,0,0"/>
    </StackPanel>
</UserControl>
