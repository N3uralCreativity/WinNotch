<Window x:Class="WinNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Title="WinNotch">

    <!-- Fixed-size window; notch shape animates inside it. No window resizing. -->
    <Grid x:Name="RootGrid">
        <Canvas x:Name="NotchCanvas"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top">

            <!-- Shadow layer (below the notch) -->
            <Path x:Name="ShadowPath"
                  Fill="Black">
                <Path.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Main notch shape -->
            <Path x:Name="NotchPath"
                  Fill="Black"
                  Cursor="Hand"/>

            <!-- Clip region for content (matches notch shape) -->
            <Grid x:Name="ContentGrid" ClipToBounds="True">
                <!-- Closed state content -->
                <Grid x:Name="ClosedContent" Opacity="1">
                </Grid>

                <!-- Open state content -->
                <Grid x:Name="OpenContent" Opacity="0" Margin="20,10,20,16">
                    <TextBlock Text="WinNotch"
                               Foreground="#888888"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
