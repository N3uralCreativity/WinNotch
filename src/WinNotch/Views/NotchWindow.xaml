<Window x:Class="WinNotch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WinNotch.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Title="WinNotch"
        Left="{Binding WindowLeft, Mode=TwoWay}"
        Top="{Binding WindowTop, Mode=TwoWay}"
        Width="{Binding WindowWidth, Mode=OneWay}"
        Height="{Binding WindowHeight, Mode=OneWay}">

    <Grid x:Name="RootGrid">
        <!-- The notch shape drawn as a Path, centered horizontally -->
        <Canvas x:Name="NotchCanvas"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">

            <!-- Shadow layer (below the notch) -->
            <Path x:Name="ShadowPath"
                  Fill="Black"
                  Canvas.Left="0" Canvas.Top="0">
                <Path.Effect>
                    <BlurEffect Radius="12" KernelType="Gaussian"/>
                </Path.Effect>
            </Path>

            <!-- Main notch shape -->
            <Path x:Name="NotchPath"
                  Fill="Black"
                  Canvas.Left="0" Canvas.Top="0"
                  Cursor="Hand"/>

            <!-- Content overlay (inside the notch) -->
            <Grid x:Name="ContentGrid"
                  Canvas.Left="0" Canvas.Top="0"
                  ClipToBounds="True">

                <!-- Closed state content -->
                <Grid x:Name="ClosedContent" Opacity="1">
                    <!-- Placeholder: small centered pill -->
                </Grid>

                <!-- Open state content -->
                <Grid x:Name="OpenContent" Opacity="0" Margin="20,10,20,16">
                    <TextBlock Text="WinNotch"
                               Foreground="#888888"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</Window>
