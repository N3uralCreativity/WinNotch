<UserControl x:Class="WinNotch.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="160">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Today header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="DayOfWeekText"
                       Text="Thursday"
                       Foreground="#888888"
                       FontSize="10"
                       FontWeight="Medium"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="DayNumberText"
                           Text="17"
                           Foreground="White"
                           FontSize="26"
                           FontWeight="Bold"
                           VerticalAlignment="Bottom"/>
                <TextBlock x:Name="MonthText"
                           Text="Jul"
                           Foreground="#666666"
                           FontSize="12"
                           VerticalAlignment="Bottom"
                           Margin="6,0,0,4"/>
            </StackPanel>
        </StackPanel>

        <!-- Events list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EventsPanel">
                <!-- "No events" placeholder -->
                <TextBlock x:Name="NoEventsText"
                           Text="No upcoming events"
                           Foreground="#555555"
                           FontSize="10"
                           FontStyle="Italic"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
