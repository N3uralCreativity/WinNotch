<UserControl x:Class="WinNotch.Views.PluginManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="760"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Components/PluginSurfaceStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DropShadowEffect x:Key="PluginWindowShadow"
                              BlurRadius="32"
                              ShadowDepth="0"
                              Opacity="0.22"
                              Color="Black"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Margin="18"
                Padding="24"
                Background="{DynamicResource NotchFillBrush}"
                CornerRadius="28"
                Effect="{StaticResource PluginWindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Plugin Manager"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Enable, disable, and organize what lives inside WinNotch."
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Content="X"
                            Style="{StaticResource PluginTitlebarButton}"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="InstalledCountText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Installed plugins can be toggled, updated, and configured from here."
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button x:Name="RefreshLibraryButton"
                            Grid.Column="1"
                            MinWidth="128"
                            Margin="12,0,0,0"
                            Content="Refresh Library"
                            Style="{StaticResource PluginSecondaryButton}"/>

                    <Button x:Name="BrowsePluginsButton"
                            Grid.Column="2"
                            MinWidth="118"
                            Margin="10,0,0,0"
                            Content="Browse Plugins"
                            Style="{StaticResource PluginPrimaryButton}"/>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="ConfigurationColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SegmentedBgBrush}"
                            CornerRadius="24"
                            Padding="16,16,10,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{StaticResource RoundedScrollViewer}">
                            <StackPanel x:Name="PluginListPanel"/>
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="ConfigurationPanelBorder"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Padding="18"
                            Background="{DynamicResource SegmentedBgBrush}"
                            CornerRadius="24"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="ConfigurationTitleText"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="ConfigurationBodyText"
                                               Margin="0,6,0,0"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Button x:Name="CloseConfigurationButton"
                                        Grid.Column="1"
                                        Width="28"
                                        Height="28"
                                        Content="X"
                                        Style="{StaticResource PluginTitlebarButton}"/>
                            </Grid>

                            <Border Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Padding="12"
                                    Background="{DynamicResource NotchFillBrush}"
                                    CornerRadius="18">
                                <TextBlock x:Name="ConfigurationStatusText"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>

                            <TextBlock x:Name="ConfigurationApplyResultText"
                                       Grid.Row="2"
                                       Margin="0,12,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource PluginPositiveBrush}"/>

                            <ScrollViewer Grid.Row="3"
                                          Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource RoundedScrollViewer}">
                                <StackPanel x:Name="ConfigurationFieldHost"/>
                            </ScrollViewer>

                            <Button x:Name="ApplyConfigurationButton"
                                    Grid.Row="4"
                                    Margin="0,16,0,0"
                                    MinWidth="140"
                                    HorizontalAlignment="Left"
                                    Content="Apply Configuration"
                                    Style="{StaticResource PluginPrimaryButton}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="OpenPluginsFolderButton"
                            Grid.Column="0"
                            MinWidth="118"
                            HorizontalAlignment="Left"
                            Content="Open Folder"
                            Style="{StaticResource PluginGhostButton}"/>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Changes apply after restart when needed."/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
