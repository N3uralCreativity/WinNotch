<Window x:Class="WinNotch.Views.PluginBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Browse Plugins" Height="550" Width="700"
        Background="#1C1C1E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Grid Grid.Row="0" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="13"
                     Background="#2C2C2E"
                     Foreground="White"
                     BorderBrush="#3A3A3C"
                     BorderThickness="1"/>

            <Button x:Name="SearchButton"
                    Grid.Column="1"
                    Content="Search"
                    Width="80"
                    Height="36"
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- Plugin List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,20">
            <StackPanel x:Name="PluginListPanel">
                <!-- Available plugins will be added here dynamically -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
