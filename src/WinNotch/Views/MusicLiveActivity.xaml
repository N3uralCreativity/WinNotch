<UserControl x:Class="WinNotch.Views.MusicLiveActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:WinNotch.Views.Components">

    <!-- Compact music indicator shown in the closed notch -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Album art with soft faded edges -->
        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="4"
                ClipToBounds="True" Margin="0,0,6,0">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFFFF" Offset="0.15"/>
                    <GradientStop Color="#FFFFFFFF" Offset="0.85"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
            <Image x:Name="CompactAlbumArt"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- Song title -->
        <TextBlock x:Name="CompactTitle"
                   Grid.Column="1"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   VerticalAlignment="Center"
                   Padding="0,1,0,0"
                   Margin="0,0,4,0"/>

        <!-- Audio visualizer: 4 thin pill bars, center-grow -->
        <comp:AudioVisualizer x:Name="CompactVisualizer"
                              Grid.Column="2"
                              Width="22" Height="18"
                              BarCount="4"
                              BarWidth="3"
                              BarGap="2"
                              VerticalAlignment="Center"
                              Margin="0,0,1,0"/>
    </Grid>
</UserControl>
