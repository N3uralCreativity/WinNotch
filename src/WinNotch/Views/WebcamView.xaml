<UserControl x:Class="WinNotch.Views.WebcamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Circular webcam mirror, mirrored horizontally like a real mirror -->
    <Grid Width="110" Height="110">
        <Grid.Clip>
            <EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55"/>
        </Grid.Clip>

        <Image x:Name="WebcamImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="LowQuality">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="-1" CenterX="55"/>
            </Image.RenderTransform>
        </Image>

        <!-- Subtle inner border ring -->
        <Border CornerRadius="55"
                BorderThickness="1.5"
                BorderBrush="{DynamicResource SeparatorBrush}"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
