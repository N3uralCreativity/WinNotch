<UserControl x:Class="WinNotch.Views.WebcamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Circular webcam mirror, mirrored horizontally like a real mirror -->
    <Grid Width="130" Height="130">
        <Border x:Name="WebcamBorder"
                CornerRadius="65"
                ClipToBounds="True"
                Background="{DynamicResource NotchFillBrush}">
            <Image x:Name="WebcamImage"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="LowQuality">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1" CenterX="65"/>
                </Image.RenderTransform>
            </Image>
        </Border>

        <!-- Subtle inner border ring -->
        <Border CornerRadius="65"
                BorderThickness="1.5"
                BorderBrush="{DynamicResource SeparatorBrush}"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
